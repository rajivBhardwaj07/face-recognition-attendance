BACKEND_URL=http://localhost:5000/api
# Admin account the service logs in with (token is fetched and refreshed automatically)
SERVICE_EMAIL=admin@demo.com
SERVICE_PASSWORD=password123
# Optional: a fixed admin JWT instead of email/password
SERVICE_TOKEN=
RECOGNITION_THRESHOLD=0.55
COOLDOWN_SECONDS=30
# Require a blink before marking attendance (blocks photo spoofing). Set to false to disable.
LIVENESS_REQUIRED=true
